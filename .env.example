# Copy this file to .env and fill in real values before running the app.
# .env is gitignored — never commit real secrets.

# --- YouTube Performance Reporter (src/app/yt, src/app/api/yt) ---

# SQLite datasource for Prisma. No Postgres is required for local dev;
# the schema (prisma/schema.prisma) stays Postgres-compatible if you
# later want to point this at a real Postgres instance instead.
DATABASE_URL="file:./prisma/dev.db"

# HMAC secret used to sign the session cookie (src/lib/yt/auth/session.ts).
# Generate a real random value for anything beyond local dev, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-random-secret"

# Seed user created by `npm run db:seed` (prisma/seed.ts) — the first
# internal login for the app.
SEED_USER_EMAIL="admin@wemul.cl"
SEED_USER_NAME="Wemul Admin"
SEED_USER_PASSWORD="change-me"

# --- Pre-existing "Cross-border Editorial Opportunity Dashboard" app (src/app/page.tsx) ---

# Optional. Only used to enrich topic angles/hooks via Claude; the
# ingestion pipeline degrades gracefully (skips enrichment) if unset.
ANTHROPIC_API_KEY=
